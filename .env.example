DISCORD_TOKEN=
# server id: slash commands register there instantly, otherwise global (up to 1 hour)
GUILD_ID=
# mention put in live alerts: @here, @everyone, or a role id like <@&123456789>
PING=@here
# seconds between tiktok checks
POLL_SECONDS=60
# dashboard. keep HOST on 127.0.0.1 unless you really want it reachable from the network
HOST=127.0.0.1
PORT=3000
